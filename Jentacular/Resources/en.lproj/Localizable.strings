"help_faq_q1" = "How to connect to VPN?";
"help_faq_a1" = "Tap the large connect button on the home screen. On first connection, the system will request permission to add a VPN configuration.";
"help_faq_q2" = "What protocol is used?";
"help_faq_a2" = "We use the IKEv2 protocol with AES-256-GCM encryption for maximum security and speed.";
"help_faq_q3" = "Do you store logs?";
"help_faq_a3" = "No, we do not store logs of your activity. Your traffic is encrypted and cannot be decrypted even by us.";
"help_faq_q4" = "Why is the connection slow?";
"help_faq_a4" = "Try reconnecting or check the quality of your internet connection. Speed is also affected by distance to the server.";
"help_conn_q1" = "Can't connect";
"help_conn_a1" = "Make sure you have an active internet connection. Try restarting the app and connecting again.";
"help_conn_q2" = "Connection keeps dropping";
"help_conn_a2" = "This may be due to an unstable internet connection. Try switching to another Wi-Fi network or mobile data.";
"help_conn_q3" = "How to disconnect?";
"help_conn_a3" = "Tap the connect button on the home screen again to disconnect.";
"help_acc_q1" = "Is registration required?";
"help_acc_a1" = "No, registration or account creation is not required to use our VPN.";
"help_acc_q2" = "How to restore access?";
"help_acc_a2" = "Since we have no account system, you don't need to restore access. Just install the app and connect.";
"help_sec_q1" = "How secure is VPN?";
"help_sec_a1" = "We use military-grade AES-256-GCM encryption and the IKEv2 protocol, providing maximum security.";
"help_sec_q2" = "What is Kill Switch?";
"help_sec_a2" = "Kill Switch automatically disconnects internet if the VPN connection drops, preventing data leaks.";
"help_tech_q1" = "What devices are supported?";
"help_tech_a1" = "The app works on all devices with iOS 15.0 and above, including iPhone and iPad.";
"help_tech_q2" = "How much traffic can I use?";
"help_tech_a2" = "We do not limit traffic volume. You can use VPN without restrictions.";
"help_bill_q1" = "Is the app free?";
"help_bill_a1" = "Yes, basic VPN features are completely free. We do not charge for using our service.";
